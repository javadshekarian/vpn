<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@android:color/black</item>
        <item name="colorPrimaryDark">@android:color/black</item>
        <item name="colorAccent">@color/purple_500</item>
        <item name="android:textColorPrimary">@android:color/white</item>
        <item name="android:colorPrimary">@android:color/black</item>
    </style>

    <style name="NavigationViewStyle" parent="Widget.Design.NavigationView">
        <item name="android:background">@android:color/black</item>
        <item name="android:itemTextAppearance">@style/NavigationViewTextAppearance</item>
    </style>

    <style name="NavigationViewTextAppearance" parent="TextAppearance.AppCompat.Body2">
        <item name="android:textColor">@android:color/white</item>
    </style>
</resources>